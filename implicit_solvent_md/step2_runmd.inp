* GENERATED BY CHARMM-GUI (http://www.charmm-gui.org) v2.0 on May, 07. 2019. JOBID=1557235621
* Calculate energy and run simulations with FACTS implicit solvation model  (param22)
* Reference:
* Haberthuer and Caflisch, J. Comput. Chem., 29(5): 701-715, 2008
* DOI: 10.1002/jcc.20832
*

! based on step2_implicit.inp, modified by SB May 2019 to separate equil/prod. phase

!DIMENS CHSIZE 3000000 MAXRES 3000000

! Read topology and parameter files
stream toppar.str

! Read PSF
open read unit 10 card name step1_pdbreader.psf
read psf  unit 10 card xplor

! Read COOR
open read unit 10 card name step1_pdbreader.crd
read coor unit 10 card

!
! FACTS setup (param22)
!
! Protein dielectric constant
set diele 1.0
! Non-polar surface tension [cal/A^2]
set gamma 0.015

nbond nbxmod 5 atom cdiel eps @diele shift vatom vdistance vswitch -
      cutnb 14.0 ctofnb 12.0 ctonnb 10.0 e14fac 1.0 wmin 1.5

scalar wmain = radius

facts tcps 22 teps @diele gamm @gamma tavw

ENERGY

!
! short minimization and Langevin dynamics
! NOTE: CHANGE ISEED EACH TIME FOR RESTART IN LANGEVIN DYNAMICS
!

mini   sd nstep 50 nprint 10 step 0.005 inbfrq -1
mini abnr nstep 50 nprint 10 step 0.005 inbfrq -1

set fbeta = 5
set temp  = 300.0

scalar fbeta set @fbeta
scalar fbeta set 0.0    select type H* end

shake bonh param fast

open write unit 12 card name equil.rst

DYNAMICS LANGEVIN      start          nstep   10000  timestp 0.002  -
         nprint   100  iprfrq   5000  -
         inbfrq    -1  imgfrq     -1  ihbfrq      0  ilbfrq      0 -
         firstt @temp  finalt  @temp  iseed 47858436 -
         tbath  @temp  rbuf      0.0  -
         iunread   -1  iunwrite   12  iuncrd     -1  iunvelo    -1 -
         nsavcrd  20  nsavvelo    0  -
         iasvel     1

open read  unit 11 card name equil.rst
open write unit 12 card name prod.1.rst
open write unit 13 file name prod.1.dcd

DYNAMICS LANGEVIN      restart        nstep   20000  timestp 0.002  -
         nprint   100  iprfrq   5000  -
         inbfrq    -1  imgfrq     -1  ihbfrq      0  ilbfrq      0 -
         firstt @temp  finalt  @temp  -
         tbath  @temp  rbuf      0.0  -
         iunread   11  iunwrite   12  iuncrd     13  iunvelo    -1 -
         nsavcrd  100  nsavvelo    0  -
         iasvel     1


ENERGY

open write card unit 10 name step2_runmd.pdb
write coor pdb  unit 10

stop
